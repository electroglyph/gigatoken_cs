<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <EnableLibraryImportGenerator>true</EnableLibraryImportGenerator>
    <PackageId>gigatoken_cs</PackageId>
    <VersionPrefix>0.12.0</VersionPrefix>
    <Authors>Gigatoken contributors</Authors>
    <Description>High-throughput BPE / SentencePiece tokenizer (.NET 10 port of gigatoken).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/electroglyph/gigatoken_cs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gigatoken;tokenizer;bpe;sentencepiece;tiktoken</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Reproducible + debuggable packages: embedded symbols (no .snupkg), SourceLink. -->
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Native payloads land here via build.sh (cargo build, release, per target triple). -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <Content Include="runtimes/**/native/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Gigatoken.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" />
  </ItemGroup>

</Project>
